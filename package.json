{
  "name": "base-contracts",
  "version": "1.0.0",
  "description": "Eleven standalone Solidity contracts and a minimal deploy script for Base",
  "scripts": {
    "compile": "node compile.js",
    "test": "node --test \"test/*.test.js\"",
    "deploy": "node deploy.js --network base",
    "abi": "node scripts/export-abi.js",
    "gas": "node scripts/gas-report.js",
    "verify": "node scripts/verify.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "solidity",
    "base",
    "ethereum",
    "smart-contracts",
    "evm"
  ],
  "author": "Sebastian (knollexp)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ethers": "^6.17.0",
    "solc": "^0.8.38"
  },
  "devDependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1"
  },
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knollexp/base-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/knollexp/base-contracts/issues"
  },
  "homepage": "https://github.com/knollexp/base-contracts#readme",
  "files": [
    "contracts",
    "abi",
    "compile.js",
    "deploy.js",
    "scripts"
  ]
}
