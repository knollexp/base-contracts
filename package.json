{
  "name": "base-contracts",
  "version": "1.0.0",
  "description": "Eleven standalone Solidity contracts and a minimal deploy script for Base",
  "scripts": {
    "compile": "node compile.js",
    "test": "node --test \"test/*.test.js\"",
    "deploy": "node deploy.js --network base",
    "abi": "node scripts/export-abi.js",
    "gas": "node scripts/gas-report.js",
    "verify": "node scripts/verify.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
