# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The deployer of a contract is the address that sends the creation
# transaction, so deploy from the address you want credited.
PRIVATE_KEY=

# Optional. Falls back to the public endpoints, which rate-limit.
# BASE_RPC_URL=
# BASE_SEPOLIA_RPC_URL=

# Optional. Only needed by scripts/verify.js.
# BASESCAN_API_KEY=
